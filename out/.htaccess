# ------------------------------------------------------------------
# ASSAULT BOATS — assaultboats.nl
# Statische site. Er draait hier geen PHP en geen Node.js.
# ------------------------------------------------------------------

# De voorpagina.
DirectoryIndex index.html

# Next.js schrijft een eigen 404-pagina; laat Apache die gebruiken.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Bestanden onder /_next/static/ hebben een hash in hun naam en veranderen
  # nooit meer; die mogen een jaar in de cache van de bezoeker blijven.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML nooit lang cachen: anders zien bezoekers na een update de oude pagina.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Beeld en de prijslijst: een week, zodat een nieuwe versie snel doorkomt.
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|pdf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>
