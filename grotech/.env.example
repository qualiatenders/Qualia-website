# ─────────────────────────────────────────────────────────────────────────────
# GROTECH — configuratie. Kopieer naar .env.local (ontwikkeling) of zet deze
# variabelen in de omgeving van de server (productie). Nooit committen.
# ─────────────────────────────────────────────────────────────────────────────

# Publieke basis-URL, zonder slash aan het eind. Gebruikt voor canonical, sitemap,
# Open Graph en links in e-mails.
NEXT_PUBLIC_SITE_URL=https://www.grotech.nl

# ── Bedrijfsgegevens (worden alleen getoond als ze zijn ingevuld) ────────────
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_STREET=
NEXT_PUBLIC_COMPANY_POSTAL_CODE=
NEXT_PUBLIC_COMPANY_CITY=
NEXT_PUBLIC_COMPANY_KVK=
NEXT_PUBLIC_COMPANY_VAT=
NEXT_PUBLIC_COMPANY_LINKEDIN=

# ── Opslag ────────────────────────────────────────────────────────────────────
# Map buiten de webroot waar aanvragen en bestanden worden opgeslagen.
# Standaard: ./storage (alleen voor ontwikkeling).
GROTECH_DATA_DIR=
# 32-byte sleutel (base64) voor versleuteling van geüploade bestanden at rest.
# Genereer met:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Verplicht in productie.
FILE_ENCRYPTION_KEY=
# Geheim voor het ondertekenen van formuliertokens (spam-bescherming).
# Genereer met:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORM_SECRET=

# ── E-mail (SMTP) ─────────────────────────────────────────────────────────────
# Zonder SMTP_HOST worden e-mails in ontwikkeling als .eml-bestand opgeslagen in
# <GROTECH_DATA_DIR>/outbox in plaats van verzonden.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Alleen voor een lokale testserver zonder TLS:
# SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
# Afzender, bijv. "GROTECH <noreply@grotech.nl>" (domein moet SPF/DKIM hebben).
MAIL_FROM=
# Ontvanger(s) van interne notificaties, komma-gescheiden.
MAIL_NOTIFY_TO=

# ── Beheeromgeving (/beheer) ─────────────────────────────────────────────────
# Zonder deze twee waarden is /beheer volledig uitgeschakeld (404).
ADMIN_USER=
ADMIN_PASSWORD=

# ── Netwerk ───────────────────────────────────────────────────────────────────
# Zet op true wanneer de app achter een vertrouwde reverse proxy (nginx) draait,
# zodat het IP-adres voor rate limiting uit X-Forwarded-For wordt gelezen.
TRUST_PROXY=false

# ── Analytics (optioneel, cookieloos) ────────────────────────────────────────
# Bijvoorbeeld Plausible (EU) of een zelf-gehoste Umami. Leeg = geen analytics.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
