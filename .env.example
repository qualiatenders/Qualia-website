# Meting (optioneel). Zonder deze regel plaatst de site geen enkele cookie
# en verschijnt er ook geen cookiebanner.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Contactformulier (optioneel). Een dienst die een JSON-POST accepteert,
# bijvoorbeeld Formspree of Web3Forms. Zonder deze regel opent het
# formulier de mailclient van de bezoeker met alles al ingevuld.
# NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxx
