# ------------------------------------------------------------------
# ASSAULT BOATS — assaultboats.nl
# Statische site. Er draait hier geen PHP en geen Node.js.
# ------------------------------------------------------------------

# De voorpagina.
DirectoryIndex index.html

# Next.js schrijft een eigen 404-pagina; laat Apache die gebruiken.
ErrorDocument 404 /404.html

# ------------------------------------------------------------------
# WWW NAAR NON-WWW
#
# Staat bewust UIT. Zet dit pas aan als aan twee dingen is voldaan:
#
#  1. Het SSL-certificaat dekt zowel assaultboats.nl als
#     www.assaultboats.nl. Zonder dat helpt deze regel niets: de browser
#     controleert het certificaat voordat hij ook maar iets van de server
#     leest, dus de waarschuwing komt hoe dan ook eerst.
#  2. De hosting serveert de site op assaultboats.nl en verwijst niet
#     zelf al van assaultboats.nl naar www. Doet hij dat wel, dan maken
#     deze regels samen een oneindige lus.
#
# Zonder deze regel is de site op twee adressen bereikbaar met dezelfde
# inhoud. De canonical-tags in de HTML wijzen al naar de versie zonder
# www, dus Google kiest de goede — maar één adres is netter.
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTP_HOST} ^www\.assaultboats\.nl$ [NC]
#   RewriteRule ^(.*)$ https://assaultboats.nl/$1 [R=301,L]
# </IfModule>

<IfModule mod_headers.c>
  # Bestanden onder /_next/static/ hebben een hash in hun naam en veranderen
  # nooit meer; die mogen een jaar in de cache van de bezoeker blijven.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML nooit lang cachen: anders zien bezoekers na een update de oude pagina.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Beeld en de prijslijst: een week, zodat een nieuwe versie snel doorkomt.
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|pdf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>
