{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // grotech/ is een los project met zijn eigen tsconfig en next.config. Zonder
  // deze uitsluiting trekt de typecheck van de Assault-build die bestanden mee
  // en faalt hij op imports die daar naar hun eigen lib/ verwijzen.
  "exclude": ["node_modules", "grotech"]
}
